meta {
  name: Login as Admin
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{password}}"
  }
}

docs {
  # Login as Admin

  Demo: `admin@barivara.dev` / `Password123`.

  Needed for List Users, role updates, owner-request review, Stats.
}
