meta {
  name: Reset Password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{tenantEmail}}",
    "otp": "{{otp}}",
    "password": "Password123"
  }
}

docs {
  # Reset Password

  Sets a new password after OTP verification. Does not auto-login.
}
