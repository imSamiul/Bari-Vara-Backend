# Template only — copy to the local file (do not commit it):
#   cp .env.example .env.development
# Used by: pnpm dev / pnpm seed / pnpm test
# Production (Render): set the same keys in the dashboard — no .env.production file.

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Atlas (allow 0.0.0.0/0 for Render) or local mongod.
MONGODB_URI=mongodb://localhost:27017/bari-vara
# Local: pnpm docker:up → redis://localhost:6379 (fast).
# Upstash: must be rediss:// (TLS). Plain redis:// hangs / fails.
REDIS_URL=redis://localhost:6379

# Min 32 chars. Use different values on Render than locally.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-min-32
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Local: http://localhost:3000 — Live: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
# Leave blank for Vercel + Render (cross-site cookies).
COOKIE_DOMAIN=

# Required when NODE_ENV=production (Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bari Vara <no-reply@bari-vara.local>

# Same as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID. Empty disables Google sign-in.
GOOGLE_CLIENT_ID=

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

FLAT_CACHE_TTL_SECONDS=60
