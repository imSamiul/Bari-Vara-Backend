# Copy to .env and fill in. Never commit the filled file.

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB: Atlas free M0 in production, or local mongod (not Docker).
# Atlas: Network Access must allow 0.0.0.0/0 for Render.
MONGODB_URI=mongodb://localhost:27017/bari-vara
# Redis: Upstash (rediss://...) in production, or `pnpm docker:up` locally.
REDIS_URL=redis://localhost:6379

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use different values in production (Render dashboard) than locally.
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-min-32
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma separated list of allowed browser origins
# Production: your Vercel URL, e.g. https://bari-vara.vercel.app
CORS_ORIGIN=http://localhost:3000
# Leave blank when frontend and API are on different sites (Vercel + Render).
# Only set this if both share a parent domain, e.g. .barivara.com
COOKIE_DOMAIN=

# https://console.cloudinary.com -> Dashboard (required when NODE_ENV=production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For Gmail use an App Password, not your account password (required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bari Vara <no-reply@bari-vara.local>

# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
# Leave empty to disable "Sign in with Google".
GOOGLE_CLIENT_ID=

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

FLAT_CACHE_TTL_SECONDS=60
