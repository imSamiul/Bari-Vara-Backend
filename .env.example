# Copy to .env and fill in. Never commit the filled file.

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Local Docker Compose defaults
MONGODB_URI=mongodb://localhost:27017/bari-vara
REDIS_URL=redis://localhost:6379

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-min-32
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma separated list of allowed browser origins
# Production: your Vercel URL, e.g. https://bari-vara.vercel.app
CORS_ORIGIN=http://localhost:3000
# Leave blank when frontend and API are on different sites (Vercel + Render).
# Only set this if both share a parent domain, e.g. .barivara.com
COOKIE_DOMAIN=

# https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For Gmail use an App Password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bari Vara <no-reply@bari-vara.local>

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

FLAT_CACHE_TTL_SECONDS=60
